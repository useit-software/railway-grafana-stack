{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "grafana": {
      "source": {
        "rootDirectory": "/grafana"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 100
      }
    },
    "loki": {
      "source": {
        "rootDirectory": "/loki"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/ready",
        "healthcheckTimeout": 100
      }
    },
    "tempo": {
      "source": {
        "rootDirectory": "/tempo"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/ready",
        "healthcheckTimeout": 100
      }
    },
    "prometheus": {
      "source": {
        "rootDirectory": "/prometheus"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/-/healthy",
        "healthcheckTimeout": 100
      }
    }
  }
}
